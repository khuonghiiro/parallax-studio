{
  "name": "parallax-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "engine": "cargo run --manifest-path engine/Cargo.toml -- --workspace ./workspace --web ./dist",
    "mcp": "tsx mcp/server.ts",
    "test": "vitest run",
    "test:mcp": "tsx tests/mcp.integration.ts",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "test:quality": "node --test scripts/quality/*.test.mjs",
    "check:docs": "node scripts/quality/check-doc-sync.mjs",
    "check": "tsc -b",
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
