{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Parallax Studio",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$DESKTOP/*", "$DOCUMENT/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.parallax.studio",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Parallax Studio — 2.5D Animation & Filmmaking",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
